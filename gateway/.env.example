# noware AirCube gateway configuration.
# Copy to gateway/.env (gitignored) or export the same variables in the
# environment. Process environment wins over this file.

# Where to publish. Local development server: http://localhost:8080
# Production: https://noware.so
NOWARE_API=http://localhost:8080

# Bearer token, at least 32 characters, also listed in the server's
# GATEWAY_TOKENS. Without it the collector only captures locally.
# Generate one with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-44
GATEWAY_TOKEN=

# Shown to viewers as the publisher of the shared cube. Default: the hostname.
GATEWAY_LABEL=office-mac-mini

# Identifies this cube to the home model, and the room it sits in.
AIRCUBE_DEVICE_KEY=aircube-office
AIRCUBE_ROOM=Office

# Optional: skip USB discovery and open this port instead.
# AIRCUBE_PORT=/dev/cu.usbmodemXXXX

# Loopback health endpoint: http://127.0.0.1:8787/health
GATEWAY_HEALTH_PORT=8787

# State (publisher id) and daily JSONL captures. Defaults under ~/.noware-gateway.
# GATEWAY_STATE_DIR=
# GATEWAY_CAPTURE_DIR=
GATEWAY_CAPTURE_DAYS=14

# debug | info | warn | error
LOG_LEVEL=info
